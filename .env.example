# =============================================================================
# Africœur — variables d'environnement (copier vers .env)
# =============================================================================
# Deux modes :
#   1) TEST (recommandé pour démarrer)  → Supabase CLOUD + back/front/redis Docker
#   2) PROD/local complet               → Supabase SELF-HOSTED (compose dédié)
# -----------------------------------------------------------------------------

# --- Django ------------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-with-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO

# --- Supabase ----------------------------------------------------------------
# En mode TEST : valeurs du projet Supabase Cloud (Project Settings → API / Database).
# En mode SELF-HOSTED : voir supabase/.env (généré) et docker-compose.supabase.yml.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# Secret JWT (Project Settings → API → JWT Settings → JWT Secret) : OBLIGATOIRE
SUPABASE_JWT_SECRET=YOUR_JWT_SECRET
SUPABASE_JWT_AUD=authenticated
SUPABASE_STORAGE_PUBLIC_BUCKET=public-media
SUPABASE_STORAGE_LEGAL_BUCKET=legal-docs

# --- Base de données (PostgreSQL Supabase) -----------------------------------
# Cloud : utiliser l'URI "Connection string" (pooler 6543 ou direct 5432).
# Format : postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
DATABASE_SSLMODE=require

# --- Redis / Celery ----------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- E-mail (notifications par e-mail uniquement — pas de SMS) ---------------
# Dev : console (les e-mails sont imprimés dans les logs du backend).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Africœur <no-reply@africoeur.org>

# --- Commissions (modèle économique) -----------------------------------------
COMMISSION_MEDICAL=0.025
COMMISSION_NGO=0.015

# --- Passerelles de paiement (laisser vide => mode bac à sable) --------------
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CAMPAY_USERNAME=
CAMPAY_PASSWORD=
FLUTTERWAVE_SECRET_KEY=

# --- Frontend (Next.js — variables exposées au navigateur) -------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
NEXT_PUBLIC_SUPABASE_PUBLIC_BUCKET=public-media

# --- Données de démonstration au démarrage du backend ------------------------
SEED_DEMO=true

# =============================================================================
# Supabase SELF-HOSTED (utilisé uniquement par docker-compose.supabase.yml)
# =============================================================================
POSTGRES_PASSWORD=super-secret-postgres-password
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters
ANON_KEY=generated-anon-key
SERVICE_ROLE_KEY=generated-service-role-key
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=change-me
SITE_URL=http://localhost:3000
