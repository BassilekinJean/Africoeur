nge, MTN, Wave, Airtel) or bank card for the diaspora."},"s3":{"title":"Escrow account","text":"Collected funds are held in a dedicated platform account."},"s4":{"title":"Release on documents","text":"Direct payment to the hospital or supplier — never to the family."}}},"campaigns":{"title":"Validated appeals","subtitle":"Medical cases and NGO projects verified upfront. Follow progress in real time.","filters":{"all":"All","search":"Search an appeal…","category":"Category","country":"Country","status":"Status","type":"Type","reset":"Reset"},"type":{"medical":"Medical","ngo_project":"NGO project"},"category":{"health":"Health","emergency":"Emergency","education":"Education","development":"Development","social":"Social"},"statusLabel":{"active":"Active","closed":"Closed","funded":"Goal reached"},"empty":"No appeal matches your search.","raised":"raised","goal":"goal","donors":"donors","daysLeft":"days left","by":"By","viewDetail":"View appeal"},"detail":{"back":"All appeals","presentation":"Presentation","video":"Presentation video","updates":"Field updates","fundUsage":"Use of funds","donors":"Donors","noDonors":"Be the first to support this appeal.","anonymous":"Anonymous donor","minorNotice":"Photo blurred by default to protect a minor (image rights compliance).","patientSituation":"Situation","verifiedBy":"Appeal validated by"},"donate":{"title":"Support this appeal","amount":"Donation amount","method":"Payment method","methods":{"cinetpay":"Mobile Money (CinetPay)","campay":"Orange / MTN (Campay)","flutterwave":"Bank card (diaspora)"},"name":"Your name","email":"Your e-mail (for the receipt)","anonymous":"Donate anonymously","support":"Add support for the platform","commissionNotice":"A {rate} commission supports the platform's operations. It is shown before confirmation.","submit":"Give {amount}","submitting":"Redirecting to payment…","success":"Thank you! You will be redirected to complete your donation.","error":"Something went wrong. Please try again.","share":"Share this appeal"},"ngo":{"title":"NGO space","subtitle":"Certified organisations running health, education and development projects.","initiatives":"Ongoing initiatives","reports":"Public impact reports"},"auth":{"title":"Partner area","subtitle":"Reserved for hospital social services, certified NGOs and administrators.","email":"Work e-mail","password":"Password","totp":"Authentication code (2FA)","signin":"Sign in","signingIn":"Signing in…","mfaHint":"Two-factor authentication (TOTP) is required for certified back-offices.","noAccount":"No account yet? Certification is granted after verification by our team.","error":"Invalid credentials or uncertified account."},"dashboard":{"hospital":"Social Service — Hospital","ngo":"NGO space","admin":"Administration","welcome":"Welcome","myCampaigns":"My appeals","newCampaign":"New appeal","disbursements":"Disbursements","stats":"Statistics","collected":"Total raised","active":"Active appeals","pendingReview":"In review","pendingDisbursements":"Disbursements to approve","certifications":"Pending certifications","comingSoon":"Module under construction — the back-office API is available."},"footer":{"tagline":"The solidarity platform that puts trust at the heart of giving.","platform":"Platform","legal":"Legal & trust","cgu":"Terms of use","privacy":"Privacy policy","ethics":"Ethics charter","contact":"Contact","rights":"All rights reserved.","compliance":"OHADA · COBAC · GDPR compliant (EU diaspora)"},"common":{"loading":"Loading…","currency":"XAF"}},"now":"$undefined","timeZone":"Africa/Douala","children":["$L11","$L12","$L13"]}]
