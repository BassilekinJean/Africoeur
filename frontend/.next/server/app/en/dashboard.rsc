ange, MTN, Wave, Airtel) or bank card for the diaspora."},"s3":{"title":"Escrow account","text":"Collected funds are held in a dedicated platform account."},"s4":{"title":"Release on documents","text":"Direct payment to the hospital or supplier — never to the family."}}},"campaigns":{"title":"Validated appeals","subtitle":"Medical cases and NGO projects verified upfront. Follow progress in real time.","filters":{"all":"All","search":"Search an appeal…","category":"Category","country":"Country","status":"Status","type":"Type","reset":"Reset"},"type":{"medical":"Medical","ngo_project":"NGO project"},"category":{"health":"Health","emergency":"Emergency","education":"Education","development":"Development","social":"Social"},"statusLabel":{"active":"Active","closed":"Closed","funded":"Goal reached"},"empty":"No appeal matches your search.","raised":"raised","goal":"goal","donors":"donors","daysLeft":"days left","by":"By","viewDetail":"View appeal"},"detail":{"back":"All appeals","presentation":"Presentation","video":"Presentation video","updates":"Field updates","fundUsage":"Use of funds","donors":"Donors","noDonors":"Be the first to support this appeal.","anonymous":"Anonymous donor","minorNotice":"Photo blurred by default to protect a minor (image rights compliance).","patientSituation":"Situation","verifiedBy":"Appeal validated by"},"donate":{"title":"Support this appeal","amount":"Donation amount","method":"Payment method","methods":{"cinetpay":"Mobile Money (CinetPay)","campay":"Orange / MTN (Campay)","flutterwave":"Bank card (diaspora)"},"name":"Your name","email":"Your e-mail (for the receipt)","anonymous":"Donate anonymously","support":"Add support for the platform","commissionNotice":"A {rate} commission supports the platform's operations. It is shown before confirmation.","submit":"Give {amount}","submitting":"Redirecting to payment…","success":"Thank you! You will be redirected to complete your donation.","error":"Something went wrong. Please try again.","shar