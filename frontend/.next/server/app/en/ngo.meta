{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/[locale]/layout,_N_T_/[locale]/ngo/layout,_N_T_/[locale]/ngo/page,_N_T_/en/ngo"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/$d$locale/ngo/__PAGE__",
    "/$d$locale/ngo",
    "/$d$locale",
    "/_index",
    "/_head"
  ]
}